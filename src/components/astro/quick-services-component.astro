---
import { Card } from "@/components/ui/card";
import { Siren, Syringe, Scissors, Pill } from "@lucide/astro";

const services = [
  {
    icon: Siren,
    title: "Urgencias 24h",
    description: "Triaje inmediato y box de estabilización intensiva.",
    tint: "bg-red-100 text-emergency",
    dot: true,
  },
  {
    icon: Syringe,
    title: "Vacunas & Chip",
    description: "Inmunización oficial y alta censal en RIAC.",
    tint: "bg-mint-foam text-evergreen",
  },
  {
    icon: Scissors,
    title: "Quirófano & Cirugía",
    description: "Anestesia gaseosa segura y cirujanos colegiados.",
    tint: "bg-emerald-300 text-evergreen",
  },
  {
    icon: Pill,
    title: "Farmacia & Dieta",
    description: "Medicamentos veterinarios y dietas clínicas especializadas.",
    tint: "bg-slate-100 text-slate-700",
  },
];
---

<section class="">
  <div class="mx-auto grid max-w-7xl gap-4 px-4 pb-14 sm:grid-cols-2 sm:px-6 md:px-8 lg:grid-cols-4 lg:px-16 ">
    {services.map(({ icon: Icon, title, description, tint, dot }) => (
      <Card className="flex-row items-start gap-3 border border-emerald-100 bg-white p-4 shadow-surface-1 transition-all duration-200 hover:-translate-y-1 hover:border-emerald-200 hover:shadow-surface-2">
        <div class={`grid size-11 shrink-0 place-items-center rounded-xl ${tint}`}>
          <Icon size="20" />
        </div>
        <div>
          <h3 class="flex items-center gap-2 text-sm font-semibold text-ink">
            {title}
            {dot && <span class="size-2 rounded-full bg-red-300"></span>}
          </h3>
          <p class="mt-1 text-xs leading-4 text-ink-muted">{description}</p>
        </div>
      </Card>
    ))}
  </div>
</section>
