---
import IndicadorHorario from "../react/indicator-horario-component";
const links = [
  { label: "Inicio", href: "#inicio", active: true },
  { label: "Servicios", href: "#servicios" },
  { label: "Tarifas y Planes", href: "#tarifas" },
  { label: "Instalaciones", href: "#instalaciones" },
  { label: "Localización y Contacto", href: "#contacto" },
];

const vetdataJson = await import("../../lib/data/vet-data-info.json");

---

<header class="w-full border-b border-slate-200 bg-white shadow-sm">
  <div class="mx-auto">
    <!-- Barra principal -->
    <div
      class="flex min-h-72px flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-3 sm:px-6 lg:flex-nowrap lg:py-0"
    >
      <!-- Logo -->
      <a
        href="#inicio"
        class="flex shrink-0 items-center gap-2.5"
        aria-label="ClínicaVet, inicio"
      >
        <span
          class="grid size-9 place-items-center rounded-xl bg-emerald-800 text-white"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-6"
            fill="currentColor"
            aria-hidden="true"
          >
            <circle cx="6.5" cy="8" r="2.3"></circle>
            <circle cx="11.5" cy="5.5" r="2.3"></circle>
            <circle cx="17" cy="7" r="2.3"></circle>
            <circle cx="20" cy="11" r="2"></circle>
            <path
              d="M13 10.5c-3.7 0-7.5 4.2-7.5 7.1 0 2 1.6 3 3.3 2.2 1.4-.7 2.6-.7 4.1 0 1.6.8 3.3-.2 3.3-2.2 0-2.9-1.5-7.1-3.2-7.1Z"
            ></path>
          </svg>
        </span>

        <span class="leading-tight">
          <span class="block text-lg font-bold tracking-tight text-slate-900"
            >ClínicaVet</span
          >
          <span
            class="block text-[10px] font-semibold uppercase tracking-[0.08em] text-slate-600"
          >
            Centro Veterinario
          </span>
        </span>
      </a>

      <!-- Navegación de escritorio -->
      <nav
        class="hidden items-center gap-5 lg:flex"
        aria-label="Navegación principal"
      >
        {
          links.map(({ label, href, active }) => (
            <a
              class:list={[
                "text-sm font-medium transition-colors hover:text-emerald-800",
                active ? "text-emerald-800" : "text-slate-700",
              ]}
              href={href}
            >
              {label}
            </a>
          ))
        }
      </nav>

      <!-- Acciones -->
      <div class="flex shrink-0 items-center gap-2 m-2">
        <a
          href={`tel:${vetdataJson.contacto.urgencias.replace(/\s+/g, "")}`}
          aria-label={`Llamar a urgencias 24 horas: ${vetdataJson.contacto.urgencias}`}
          class="flex size-10 items-center justify-center gap-2 rounded-full bg-red-700 px-3 text-sm font-semibold text-white transition-colors hover:bg-red-800 md:h-12 md:w-auto"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-5 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v3m0 12v3M4.93 4.93l2.12 2.12m9.9 9.9 2.12 2.12M3 12h3m12 0h3M4.93 19.07l2.12-2.12m9.9-9.9 2.12-2.12"
            ></path>
            <circle cx="12" cy="12" r="4"></circle>
          </svg>
          <span class="hidden leading-tight md:block">
            Urgencias 24h:<br />{vetdataJson.contacto.urgencias}
          </span>
        </a>

        <a
          href="#contacto"
          class="flex size-10 items-center justify-center gap-2 rounded-full bg-emerald-800 px-3 text-sm font-semibold text-white transition-colors hover:bg-emerald-900 md:h-12 md:w-auto"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-5 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="4" y="5" width="16" height="15" rx="2"></rect>
            <path stroke-linecap="round" d="M8 3v4m8-4v4M4 10h16"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m9 15 2 2 4-4"></path>
          </svg>
          <span class="hidden leading-tight sm:block"
            >Pedir Cita<br />Online</span
          >
        </a>
      </div>
    </div>

    <!-- Navegación móvil -->
    <nav
      class="flex gap-5 overflow-x-auto border-t border-slate-100 px-4 py-3 lg:hidden"
      aria-label="Navegación principal"
    >
      {
        links.map(({ label, href, active }) => (
          <a
            class:list={[
              "shrink-0 text-sm font-medium transition-colors hover:text-emerald-800",
              active ? "text-emerald-800" : "text-slate-700",
            ]}
            href={href}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <!-- Información secundaria -->
    <div
      class="flex flex-col gap-2 bg-mint-whisper px-4 py-2.5 text-xs text-slate-700 sm:px-6 lg:flex-row lg:items-center lg:justify-between"
    >
      <!-- FORMATO PARA ESTABLECIMIENTO ABIERTO -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span
          class={`inline-flex items-center gap-2 rounded-full px-2.5 py-1 text-evergreen`}
        >
          <span class={`size-2 rounded-full`}></span>
          <IndicadorHorario client:only="react" />
        </span>
        <span class="hidden sm:inline"
          >• Hospital Veterinario Colegiado N.º 28/4921</span
        >
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a
          href={`tel:${vetdataJson.contacto.telefono.replace(/\s+/g, "")}`}
          class="inline-flex items-center gap-1.5 hover:text-emerald-800"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 4h3l2 5-2 1.5a15 15 0 0 0 5.5 5.5L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"
            ></path>
          </svg>
          {vetdataJson.contacto.telefono}
        </a>

        <a
          href={`https://maps.google.com/?q=${encodeURIComponent(vetdataJson.location.direccion)}`}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-1.5 hover:text-emerald-800"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
          {vetdataJson.location.direccionCorta}
        </a>
       
      </div>
    </div>
  </div>
</header>
