---
import { CalendarCheck2, MessageCircle } from "lucide-react";
import IndicadorHorario from "../react/indicator-horario-component";
import CarouselComponent from "../react/carousel-component";
import { Button } from "../ui/button";
import { Siren } from "@lucide/astro";

const stats = [
  {
    id: 1,
    value: "+12.000",
    label: "Pacientes atendidos",
    color: "default",
    icon: CalendarCheck2,
  },
  {
    id: 2,
    value: "99.4%",
    label: "Valoración positiva",
    color: "default",
    icon: MessageCircle,
  },
  {
    id: 3,
    value: "24/7",
    label: "Urgencias presenciales",
    color: "emergency",
    icon: Siren,
  },
];

const colorStyles = {
  default: {
    bg: "bg-green-50",
    text: "text-ink",
    label: "text-ink-muted",
  },
  emergency: {
    bg: "bg-emergency",
    text: "text-white",
    label: "text-red-100",
  },
};
---

<section id="inicio" class="bg-linear-to-b from-mint-whisper to-white">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center gap-10 px-4 py-14 sm:px-6 md:px-8 lg:flex-row lg:px-16 lg:py-20"
  >
    <div class="w-full lg:flex-1">
      <span
        class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[0.6875rem] font-bold `}
      >
        <span class={`size-1.5 rounded-full`}></span>
        <IndicadorHorario client:only="react" />
      </span>
      <h1
        class="mt-6 max-w-2xl text-4xl leading-11 font-extrabold tracking-[-0.02em] text-ink lg:text-5xl lg:leading-[1.15] lg:tracking-[-0.03em]"
      >
        Cuidado profesional, <span class="text-brand">cercano</span> y cariñoso para
        tu mascota
      </h1>
      <p class="mt-5 max-w-xl text-sm leading-6 text-ink-muted">
        Instalaciones de vanguardia humana adaptadas al bienestar animal.
        Especialistas colegiados, quirófano monitorizado continuo, diagnóstico
        digital instantáneo y prevención cariñosa sin estrés.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#contacto">
          <Button size="lg" className="h-10 px-5">
            <CalendarCheck2 size={16} />
            Agendar Cita Previa
          </Button>
        </a>
        <a href="https://wa.me/34910888777">
          <Button size="lg" variant="secondary" className="h-10 px-5">
            <MessageCircle size={16} />
            Escribir por WhatsApp
          </Button>
        </a>
      </div>
      <div class="mt-8 grid max-w-md grid-cols-3 gap-3">
        {
          stats.map((stat) => {
            const currentStyle =
              colorStyles[stat.color as keyof typeof colorStyles] ||
              colorStyles.default;
            return (
              <div
                class={`rounded-xl px-3 py-2.5 shadow-surface-1 hover:shadow-surface-2 transition-shadow duration-200 ${currentStyle.bg} flex flex-col items-start justify-between`}
              >
                <stat.icon size={20} class={`mb-1 ${currentStyle.text}`} />
                <p class={`text-lg font-bold ${currentStyle.text}`}>
                  {stat.value}
                </p>
                <p class={`text-[0.625rem] ${currentStyle.label}`}>
                  {stat.label}
                </p>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Carousel Component  -->
    <div class="w-full lg:w-[48%] lg:flex-none">
      <CarouselComponent client:visible />
    </div>
  </div>
</section>
